{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Salama client",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"Client",
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true
		},
		{
			"label": "Start Salama server",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"server",
				"run",
				"dev"
			],
			"isBackground": true
		},
		{
			"label": "Start Salama client and server",
			"dependsOn": [
				"Start Salama server",
				"Start Salama client"
			],
			"dependsOrder": "parallel"
		}
	]
}